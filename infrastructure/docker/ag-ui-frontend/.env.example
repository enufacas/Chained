# Example environment variables for AG-UI Frontend
# Copy this file to .env.local and fill in your values

# OpenAI API Key for CopilotKit
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ADK API Server URL (optional - for connecting to deployed agents)
NEXT_PUBLIC_ADK_API_URL=https://chained-adk-api-server-sguacxy5gq-uc.a.run.app

# GitHub Token (optional - for fetching workflow run data)
GITHUB_TOKEN=your_github_token_here
