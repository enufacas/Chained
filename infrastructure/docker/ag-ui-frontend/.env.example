# =============================================================================
# AG-UI Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
#
# For Cloud Run deployment, these are automatically configured via Terraform
# See infrastructure/terraform/adk-agents.tf
# =============================================================================

# =============================================================================
# LLM API Key (One of these is required for chat functionality)
# =============================================================================

# Option 1: Use Vertex AI (recommended for Cloud Run - uses ADC)
# When true, uses Application Default Credentials from service account
USE_VERTEX_AI=true

# Option 2: OpenAI API Key for CopilotKit
# Get your API key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Option 3: Google Gemini API Key (used when USE_VERTEX_AI=false)
# Get your API key from https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# A2A Agent URLs (Required for real pipeline execution)
# =============================================================================
# These are the Cloud Run URLs for the deployed A2A agents.
# On Cloud Run deployment, these are automatically set by Terraform.

# ADK API Server URL (for connecting to deployed GCP Cloud Run agents)
# This is the bridge service that routes to all A2A agents
NEXT_PUBLIC_ADK_API_URL=https://chained-adk-api-server-sguacxy5gq-uc.a.run.app

# Individual Agent URLs for direct A2A communication
AGENT_ACADEMIC_RESEARCH_URL=https://chained-academic-research-sguacxy5gq-uc.a.run.app
AGENT_GOOGLE_TRENDS_URL=https://chained-google-trends-sguacxy5gq-uc.a.run.app
AGENT_BLOG_WRITER_URL=https://chained-blog-writer-sguacxy5gq-uc.a.run.app
AGENT_CODE_REVIEWER_URL=https://chained-code-reviewer-sguacxy5gq-uc.a.run.app
AGENT_DATA_ANALYST_URL=https://chained-data-analyst-sguacxy5gq-uc.a.run.app
AGENT_IMAGE_GENERATOR_URL=https://chained-image-generator-sguacxy5gq-uc.a.run.app

# =============================================================================
# Error Observer & Monitoring (Required for error tracking and activity display)
# =============================================================================

# Error Observer URL for UI error reporting and real-time status monitoring
# This agent receives error events and dispatches them to GitHub for triage
ERROR_OBSERVER_URL=https://chained-error-observer-sguacxy5gq-uc.a.run.app

# Log Consumer URL for agent activity monitoring (optional)
AGENT_LOG_CONSUMER_URL=https://chained-log-consumer-sguacxy5gq-uc.a.run.app

# =============================================================================
# GCP Configuration (Required for blog publishing and persistence)
# =============================================================================

# GCP Project ID (for blog bucket URL construction)
# Blog URLs use format: https://storage.googleapis.com/${GCP_PROJECT_ID}-chained-blog/posts/${slug}.html
GCP_PROJECT_ID=chained-ai

# Google Cloud Project (required for Vertex AI ADC on Cloud Run)
GOOGLE_CLOUD_PROJECT=chained-ai

# Firestore Persistence (default: true in production)
# Set to false to disable Firestore and use in-memory storage only
# In production, sessions and artifacts are persisted to Firestore for reliability
USE_FIRESTORE=true
