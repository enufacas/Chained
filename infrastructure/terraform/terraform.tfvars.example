# =============================================================================
# Chained GCP Infrastructure - Example Variable Values
# =============================================================================
# Copy this file to terraform.tfvars and update with your values.
# DO NOT commit terraform.tfvars with sensitive values to version control.
# =============================================================================

# Required: Your GCP project ID
project_id = "your-gcp-project-id"

# Optional: Override default region (us-central1 is recommended for cost)
region = "us-central1"

# Optional: Environment name
environment = "dev"

# Optional: Email for infrastructure alerts
alert_email = "your-email@example.com"

# Optional: Monthly budget for cost alerts (default: $50)
monthly_budget = 50

# =============================================================================
# Container Images
# =============================================================================
# Leave these empty initially - they'll be populated after first image build
# Format: REGION-docker.pkg.dev/PROJECT_ID/chained/IMAGE_NAME:TAG
# =============================================================================

# website_image = "us-central1-docker.pkg.dev/your-project/chained/website:latest"
# agent_gateway_image = "us-central1-docker.pkg.dev/your-project/chained/agent-gateway:latest"
# agent_worker_image = "us-central1-docker.pkg.dev/your-project/chained/agent-worker:latest"

# =============================================================================
# API Keys for ADK Agents and AG-UI Frontend (CopilotKit Chat)
# =============================================================================
# These should reference secrets stored in GCP Secret Manager.
# Create secrets using: gcloud secrets create SECRET_NAME --data-file=-
# =============================================================================

# Google API Key (preferred for AG-UI Frontend CopilotKit chat feature)
# This is the standard env var used by Google APIs and CopilotKit's Gemini adapter
# google_api_key_secret = "google-api-key"

# Gemini API Key (alternative for ADK agents - used as fallback if GOOGLE_API_KEY not set)
# gemini_api_key_secret = "gemini-api-key"

# OpenAI API Key (alternative for CopilotKit chat if using OpenAI instead of Gemini)
# openai_api_key_secret = "openai-api-key"

# =============================================================================
# GitHub Configuration for Error Observer
# =============================================================================
# Repository for error-observer to dispatch errors to GitHub Actions
# Format: owner/repository (e.g., "enufacas/Chained")
# =============================================================================

# git_repo = "your-username/your-repository"
